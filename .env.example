# Copier ce fichier en .env et remplir chaque valeur. Ne jamais publier le fichier .env.

# Adresse publique de l'application
APP_URL=https://crm.honoratagbeci.com

# Base de données PostgreSQL
DATABASE_URL=postgres://crm:CHANGER_MOT_DE_PASSE@db:5432/crm
POSTGRES_PASSWORD=CHANGER_MOT_DE_PASSE

# Secrets (au moins 32 caractères aléatoires chacun : `openssl rand -hex 32`)
SESSION_SECRET=
ENCRYPTION_KEY=

# Code à usage unique pour créer le compte administrateur la première fois (/installation)
SETUP_TOKEN=

# Gmail : adresse et « mot de passe d'application » Google (validation en deux étapes requise)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Honorat AGBECI
# smtp = envoi réel par Gmail ; log = les emails sont seulement affichés dans les journaux
MAIL_TRANSPORT=smtp

# Rythme d'envoi : Gmail accepte environ 500 destinataires par jour, on garde une marge
DAILY_SEND_LIMIT=400
SEND_INTERVAL_MS=3000

# Sites autorisés à envoyer des inscriptions (séparés par des virgules)
ALLOWED_ORIGINS=https://honoratagbeci.com,https://www.honoratagbeci.com

# Secret partagé avec l'extension WordPress (même valeur dans ses réglages)
WP_SHARED_SECRET=

# Nom de domaine de l'application (certificat HTTPS automatique)
CRM_DOMAIN=crm.honoratagbeci.com
